FROM python:3.9-slim
LABEL maintainer="Manticore Software Ltd. <contact@manticoresearch.com>"

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY docker/containers/embed/requirements.txt .
# CPU-only torch: the deploy host has no GPU and the default amd64 wheel pulls
# several GB of nvidia-* CUDA packages, which exhausts disk and RAM there.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

COPY docker/containers/embed/entrypoint /entrypoint

ENTRYPOINT ["/entrypoint"]
WORKDIR /src

